# Start in fixture mode. Change to sandbox only after your PayPal app is enabled.
PAYPAL_MODE=fixture
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional AI analysis. Gemini supports a no-cost developer tier with rate limits.
# Do not enable Google Cloud billing if you want to remain on its free tier.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash

# OpenAI-compatible alternative. Leave blank when using Gemini.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

PORT=3000

AI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.1-flash-lite

AI_TIMEOUT_MS=30000

PAYPAL_WEBHOOK_ID=
AI_ENABLED=false